{
  "name": "vitalpulse-health",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "iOS Style Health & Water Tracker Desktop App",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:ui": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@vueuse/core": "^12.8.2",
    "canvas-confetti": "^1.9.4",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.vitalpulse.app",
    "productName": "VitalPulse 若水",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    }
  }
}
